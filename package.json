{
  "name": "ai-term",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local bastion sessions with a web terminal, MCP and CLI",
  "bin": {
    "ai-term": "dist/cli.js",
    "ai-term-mcp": "dist/mcp.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "web:dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json",
    "format": "prettier --write src web test *.ts *.json README.md AGENTS.md",
    "test": "node --import tsx --test test/*.test.ts",
    "test:web": "playwright test",
    "start": "node dist/cli.js serve",
    "mcp": "node dist/mcp.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
